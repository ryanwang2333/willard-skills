# 复制本文件为 .env 并填入真实 key(OpenAI 兼容的视觉服务均可,如硅基流动 SiliconFlow)
DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1
DASHSCOPE_API_KEY=sk-xxx
VISION_MODEL=Qwen/Qwen3.6-35B-A3B
# 可选：输出 token 预算（默认 8192，thinking 模型思考长可调大，即不设死预算）
# VISION_MAX_TOKENS=8192
# 可选：API 请求超时毫秒（默认 300000，即 5 分钟）
# VISION_TIMEOUT_MS=300000
